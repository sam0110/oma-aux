#!/usr/bin/env python3
"""Small JSON bridge between Oma Aux and the PipeWire command-line tools."""

from __future__ import annotations

import array
import ctypes
import hashlib
import json
import math
import os
import selectors
import signal
import subprocess
import sys
import tempfile
import time
from collections import defaultdict
from contextlib import contextmanager
from pathlib import Path

import fcntl


FILTER_BANDS = (
    ("100 Hz", "bq_lowshelf", 100),
    ("250 Hz", "bq_peaking", 250),
    ("1 kHz", "bq_peaking", 1000),
    ("4 kHz", "bq_peaking", 4000),
    ("10 kHz", "bq_highshelf", 10000),
)
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "oma-aux"
STATE_PATH = STATE_DIR / "routes.json"
LOCK_PATH = STATE_DIR / "routes.lock"
MANAGED_PREFIX = "oma_aux_route_"
METER_PREFIX = "oma_aux_meter_"
METER_LIMIT = 16
PROCESS_TOKEN = str(time.time_ns())


def fail(message: str, code: int = 1) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(code)


def pipewire_dump() -> list[dict]:
    try:
        result = subprocess.run(
            ["pw-dump"], capture_output=True, text=True, check=True, timeout=5
        )
        return json.loads(result.stdout)
    except FileNotFoundError:
        fail("pw-dump is required")
    except (subprocess.SubprocessError, json.JSONDecodeError) as error:
        fail(f"Could not read the PipeWire graph: {error}")


def is_audio_port(props: dict, node_props: dict) -> bool:
    media_class = str(node_props.get("media.class", "")).lower()
    if "video" in media_class or "midi" in media_class:
        return False
    dsp_format = str(props.get("format.dsp", "")).lower()
    return "audio" in dsp_format or bool(props.get("audio.channel"))


def node_label(props: dict) -> str:
    return str(
        props.get("application.name")
        or props.get("node.description")
        or props.get("device.description")
        or props.get("media.name")
        or props.get("node.nick")
        or props.get("node.name")
        or "Unknown node"
    )


def endpoint_key(
    node_id: int, props: dict, direction: str, session: str = PROCESS_TOKEN
) -> str:
    media_class = str(props.get("media.class") or "")
    if media_class == "Stream/Output/Audio" and direction == "out":
        for property_name in ("application.id", "application.process.binary", "application.name"):
            if props.get(property_name):
                return f"app:{property_name}:{props[property_name]}:out"
    if media_class.startswith("Stream/"):
        identity = f"stream:{session}:{props.get('object.serial') or time.time_ns()}:{node_id}"
    else:
        identity = props.get("node.name") or props.get("object.serial") or node_id
    return f"{identity}:{direction}"


def endpoint_kind(media_class: str, direction: str) -> str:
    if direction == "out":
        if media_class == "Audio/Sink":
            return "monitor"
        if media_class == "Audio/Source":
            return "source"
        if media_class == "Stream/Output/Audio":
            return "playback"
        if media_class == "Stream/Input/Audio":
            return "monitor"
    else:
        if media_class == "Audio/Sink":
            return "device"
        if media_class == "Stream/Input/Audio":
            return "recording"
        if media_class == "Stream/Output/Audio":
            return "playback"
    return "filter"


KIND_ORDER = {
    "playback": 0,
    "source": 1,
    "monitor": 2,
    "recording": 0,
    "device": 1,
    "filter": 3,
}


def normalize_graph(objects: list[dict], include_managed: bool = False) -> dict:
    nodes: dict[int, dict] = {}
    controls: dict[int, dict] = {}
    raw_ports: list[tuple[int, dict]] = []
    raw_links: list[dict] = []
    session = next(((obj.get("info") or {}).get("cookie") for obj in objects
                    if obj.get("type") == "PipeWire:Interface:Core"), None)
    if session is None:
        # Scope anonymous serials to this server, not a reusable numeric ID.
        # Recheck the socket on every dump in case the server was restarted.
        try:
            runtime = Path(os.environ.get("PIPEWIRE_RUNTIME_DIR")
                           or os.environ.get("XDG_RUNTIME_DIR")
                           or f"/run/user/{os.getuid()}")
            socket = (runtime / os.environ.get("PIPEWIRE_REMOTE", "pipewire-0")).stat()
            session = f"{socket.st_dev}-{socket.st_ino}-{socket.st_ctime_ns}"
        except OSError:
            session = str(time.time_ns())

    for obj in objects:
        object_type = obj.get("type", "")
        info = obj.get("info") or {}
        if object_type == "PipeWire:Interface:Node":
            nodes[int(obj["id"])] = info.get("props") or {}
            values = (info.get("params") or {}).get("Props") or []
            control = next((v for v in values if "channelVolumes" in v), {})
            controls[int(obj["id"])] = {k: control[k] for k in ("channelVolumes", "mute") if k in control}
        elif object_type == "PipeWire:Interface:Port":
            raw_ports.append((int(obj["id"]), info.get("props") or {}))
        elif object_type == "PipeWire:Interface:Link":
            raw_links.append(obj)

    ports_by_node: dict[int, dict[str, list[dict]]] = defaultdict(
        lambda: {"in": [], "out": []}
    )
    audio_port_ids: set[int] = set()
    for port_id, props in raw_ports:
        try:
            node_id = int(props.get("node.id"))
        except (TypeError, ValueError):
            continue
        if node_id not in nodes:
            continue
        node_props = nodes[node_id]
        direction = str(props.get("port.direction", ""))
        if direction not in ("in", "out") or not is_audio_port(props, node_props):
            continue
        port = {
            "id": port_id,
            "name": str(props.get("port.name") or props.get("port.alias") or port_id),
            "alias": str(props.get("port.alias") or ""),
            "channel": str(props.get("audio.channel") or ""),
        }
        ports_by_node[node_id][direction].append(port)
        audio_port_ids.add(port_id)

    sources: list[dict] = []
    destinations: list[dict] = []
    managed_node_ids = {
        node_id
        for node_id, props in nodes.items()
        if str(props.get("node.name") or "").startswith(MANAGED_PREFIX)
    }
    meter_node_ids = {node_id for node_id, props in nodes.items()
                      if str(props.get("node.name") or "").startswith(METER_PREFIX)}
    for node_id, directions in ports_by_node.items():
        if node_id in meter_node_ids:
            continue
        if node_id in managed_node_ids and not include_managed:
            continue
        props = nodes.get(node_id, {})
        media_class = str(props.get("media.class") or "")
        base_label = node_label(props)
        name = str(props.get("node.name") or node_id)
        for direction, target in (("out", sources), ("in", destinations)):
            ports = sorted(
                directions[direction], key=lambda port: (port["channel"], port["name"])
            )
            if not ports:
                continue
            kind = endpoint_kind(media_class, direction)
            label = f"{base_label} monitor" if kind == "monitor" else base_label
            target.append(
                {
                    "id": node_id,
                    "key": endpoint_key(node_id, props, direction, str(session)),
                    "serial": str(props.get("object.serial") or ""),
                    "lifetime": f"{session}:{props.get('object.serial', '')}:{node_id}",
                    "controls": controls.get(node_id, {}),
                    "name": name,
                    "label": label,
                    "kind": kind,
                    "mediaClass": media_class,
                    "ports": ports,
                }
            )

    grouped = {}
    for source in sources:
        if source["key"].startswith("app:"):
            if source["key"] not in grouped:
                grouped[source["key"]] = {**source, "members": [], "ports": []}
            group = grouped[source["key"]]
            group["members"].append(source)
            group["ports"].extend(source["ports"])
        else:
            grouped[source["key"]] = source
    sources = list(grouped.values())
    for source in sources:
        if not source["key"].startswith("app:"):
            continue
        members = source["members"]
        available = all(member["serial"].isdigit() and member["controls"].get("channelVolumes")
                        and type(member["controls"].get("mute")) is bool for member in members)
        if not available:
            source["appControl"] = None
            continue
        volumes = [float(v) for member in members for v in member["controls"]["channelVolumes"]]
        if any(not math.isfinite(v) or v < 0 for v in volumes):
            source["appControl"] = None
            continue
        # PipeWire channel gains are linear; use the usual cubic UI scale.
        source["appControl"] = {
            "volume": round(max(volumes) ** (1 / 3) * 100, 1),
            "volumeMixed": max(volumes) - min(volumes) > 0.00001,
            "mute": all(member["controls"]["mute"] for member in members),
            "muteMixed": len({member["controls"]["mute"] for member in members}) > 1,
        }

    sort_key = lambda endpoint: (
        KIND_ORDER.get(endpoint["kind"], 99),
        endpoint["label"].casefold(),
        endpoint["id"],
    )
    sources.sort(key=sort_key)
    destinations.sort(key=sort_key)
    for endpoints in (sources, destinations):
        by_label: dict[str, list[dict]] = defaultdict(list)
        for endpoint in endpoints:
            by_label[endpoint["label"]].append(endpoint)
        for duplicates in by_label.values():
            if len(duplicates) > 1:
                for index, endpoint in enumerate(duplicates, 1):
                    endpoint["label"] = f"{endpoint['label']} {index}"

    links = []
    for obj in raw_links:
        info = obj.get("info") or {}
        try:
            output_port = int(info["output-port-id"])
            input_port = int(info["input-port-id"])
            if output_port not in audio_port_ids or input_port not in audio_port_ids:
                continue
            output_node = int(info["output-node-id"])
            input_node = int(info["input-node-id"])
            if output_node in meter_node_ids or input_node in meter_node_ids:
                continue
            if not include_managed and (
                output_node in managed_node_ids or input_node in managed_node_ids
            ):
                continue
            links.append(
                {
                    "id": int(obj["id"]),
                    "outputNode": output_node,
                    "outputPort": output_port,
                    "inputNode": input_node,
                    "inputPort": input_port,
                    "state": str(info.get("state") or ""),
                }
            )
        except (KeyError, TypeError, ValueError):
            continue

    return {"sources": sources, "destinations": destinations, "links": links}


def route_id(source_key: str, destination_key: str) -> str:
    value = f"{source_key}\0{destination_key}".encode()
    return hashlib.sha256(value).hexdigest()[:16]


def default_filter() -> dict:
    return {"pan": 0.0, "eq": [0.0] * len(FILTER_BANDS)}


def validate_filter(value: object) -> dict:
    if not isinstance(value, dict):
        fail("Filter settings must be a JSON object")
    try:
        pan = float(value.get("pan", 0.0))
        eq = [float(gain) for gain in value.get("eq", [])]
    except (TypeError, ValueError):
        fail("Pan and EQ values must be numbers")
    if not math.isfinite(pan) or not -1.0 <= pan <= 1.0:
        fail("Pan must be between -1 and 1")
    if len(eq) != len(FILTER_BANDS):
        fail(f"EQ requires {len(FILTER_BANDS)} band gains")
    if any(not math.isfinite(gain) or not -12.0 <= gain <= 12.0 for gain in eq):
        fail("EQ gains must be between -12 and 12 dB")
    return {"pan": round(pan, 3), "eq": [round(gain, 1) for gain in eq]}


@contextmanager
def state_lock():
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with LOCK_PATH.open("a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def load_state() -> dict:
    try:
        value = json.loads(STATE_PATH.read_text())
        if not isinstance(value, dict) or not isinstance(value.get("routes"), list):
            raise ValueError
        return value
    except FileNotFoundError:
        return {"version": 1, "routes": []}
    except (OSError, json.JSONDecodeError, ValueError):
        fail(f"Could not read {STATE_PATH}")


def save_state(state: dict) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix="routes.", suffix=".json", dir=STATE_DIR)
    try:
        with os.fdopen(descriptor, "w") as output:
            json.dump(state, output, indent=2)
            output.write("\n")
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, STATE_PATH)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def validate_app_settings(value: object) -> dict:
    if not isinstance(value, dict) or not value or value.keys() - {"volume", "mute"}:
        fail("App settings require volume and/or mute")
    if "volume" in value and (type(value["volume"]) not in (int, float)
            or not 0 <= value["volume"] <= 100):
        fail("App volume must be a number between 0 and 100")
    if "mute" in value and type(value["mute"]) is not bool:
        fail("App mute must be a boolean")
    return dict(value)


def apply_app_settings(source: dict, record: dict, force: dict | None = None) -> bool:
    # Persist per-field acknowledgements by server/stream lifetime, not live values.
    # Polls and fresh helper processes must not fight another mixer's later edits.
    applied = record.setdefault("applied", {})
    live = {member["lifetime"] for member in source["members"]}
    record["applied"] = applied = {k: v for k, v in applied.items() if k in live}
    success = True
    for member in source["members"]:
        previous = applied.get(member["lifetime"], {})
        pending = {k: v for k, v in record["settings"].items()
                   if k in (force or {}) or previous.get(k) != v}
        if not pending:
            continue
        applied[member["lifetime"]] = {k: v for k, v in previous.items() if k not in pending}
        # Re-resolve identity and serial immediately before addressing a numeric ID.
        current = normalize_graph(pipewire_dump())
        group = next((s for s in current["sources"] if s["key"] == source["key"]), None)
        target = next((m for m in (group or {}).get("members", [])
                       if m["lifetime"] == member["lifetime"]), None)
        if not target or not group.get("appControl"):
            success = False
            continue
        props = {}
        if "volume" in pending:
            props["channelVolumes"] = [(pending["volume"] / 100) ** 3] * len(
                target["controls"]["channelVolumes"])
        if "mute" in pending:
            props["mute"] = pending["mute"]
        try:
            result = subprocess.run(["pw-cli", "set-param", str(target["id"]), "Props",
                                     json.dumps(props)], capture_output=True, text=True, timeout=5)
            # pw-cli reports command errors on stderr even with exit status zero.
            if result.returncode or any(line.startswith("Error:") for line in result.stderr.splitlines()):
                success = False
                continue
        except (OSError, subprocess.SubprocessError):
            success = False
            continue
        applied[member["lifetime"]] = {**previous, **pending}
    return success


def set_app_settings(key: str, value: object) -> None:
    settings = validate_app_settings(value)
    with state_lock():
        graph = normalize_graph(pipewire_dump())
        source = endpoint(graph, "sources", key)
        if not source["key"].startswith("app:") or not source.get("appControl"):
            fail("Volume and mute require an identified playback application with supported controls")
        state = load_state()
        record = state.setdefault("apps", {}).setdefault(source["key"], {"settings": {}, "applied": {}})
        record["settings"].update(settings)
        success = apply_app_settings(source, record, force=settings)
        save_state(state)
    if not success:
        fail("Some application streams could not be updated; saved settings will retry")


def endpoint_by_name(graph: dict, collection: str, name: str) -> dict | None:
    return next((item for item in graph.get(collection, []) if item["name"] == name), None)


def saved_endpoint(graph: dict, collection: str, route: dict, prefix: str) -> dict | None:
    key = route.get(f"{prefix}Key")
    name = route.get(f"{prefix}Name")
    # Old numeric keys could mean either node IDs or serials. Neither proves
    # application identity, even if a current node happens to have the same name.
    if key and str(key).rsplit(":", 1)[0].isdigit():
        route["status"] = "unresolved"
        return None
    if key:
        matches = [
            item
            for item in graph.get(collection, [])
            if item["key"] == key
            and (key.startswith(("app:", "stream:")) or item["name"] == name)
        ]
        if matches:
            return matches[0]

        return None
    matches = [item for item in graph.get(collection, []) if item["name"] == name
               and not item.get("mediaClass", "").startswith("Stream/")]
    if len(matches) == 1:
        route[f"{prefix}Key"] = matches[0]["key"]
        return matches[0]
    if not key and any(item["name"] == name and item.get("mediaClass", "").startswith("Stream/")
                       for item in graph.get(collection, [])):
        route["status"] = "unresolved"
    return None


def saved_route_for_endpoints(
    state: dict, graph: dict, source: dict, destination: dict
) -> dict | None:
    for route in state["routes"]:
        saved_source = saved_endpoint(graph, "sources", route, "source")
        saved_destination = saved_endpoint(
            graph, "destinations", route, "destination"
        )
        if (
            saved_source
            and saved_destination
            and saved_source["key"] == source["key"]
            and saved_destination["key"] == destination["key"]
        ):
            return route
    return None


def process_start_time(pid: int) -> str:
    try:
        return Path(f"/proc/{pid}/stat").read_text().split()[21]
    except (OSError, IndexError):
        return ""


def route_process_alive(route: dict) -> bool:
    try:
        pid = int(route.get("pid", 0))
        command = Path(f"/proc/{pid}/cmdline").read_bytes().decode(errors="replace")
    except (OSError, TypeError, ValueError):
        return False
    return (
        pid > 0
        and route.get("processStart") == process_start_time(pid)
        and f"oma_aux_route_{route['id']}" in command
    )


def stop_route_process(route: dict) -> None:
    if not route_process_alive(route):
        return
    pid = int(route["pid"])
    try:
        os.killpg(pid, signal.SIGTERM)
    except ProcessLookupError:
        return
    for _ in range(20):
        if not route_process_alive(route):
            return
        time.sleep(0.025)
    try:
        os.killpg(pid, signal.SIGKILL)
    except ProcessLookupError:
        pass


def filter_module_arguments(route: dict, generation: str) -> tuple[str, str, str]:
    settings = route["filter"]
    capture_name = f"{MANAGED_PREFIX}{route['id']}_{generation}_input"
    playback_name = f"{MANAGED_PREFIX}{route['id']}_{generation}_output"
    nodes = []
    links = []
    inputs = []
    outputs = []
    pan = settings["pan"]
    channel_gains = (1.0 - max(0.0, pan), 1.0 + min(0.0, pan))

    for channel, channel_gain in zip(("l", "r"), channel_gains, strict=True):
        previous = ""
        for index, ((_, label, frequency), gain) in enumerate(
            zip(FILTER_BANDS, settings["eq"], strict=True)
        ):
            name = f"{channel}_eq_{index}"
            nodes.append(
                f'{{ type = builtin name = {name} label = {label} '
                f'control = {{ "Freq" = {frequency}.0 "Q" = 1.0 "Gain" = {gain:.1f} }} }}'
            )
            if previous:
                links.append(f'{{ output = "{previous}:Out" input = "{name}:In" }}')
            else:
                inputs.append(f'"{name}:In"')
            previous = name
        gain_name = f"{channel}_gain"
        nodes.append(
            f'{{ type = builtin name = {gain_name} label = mixer '
            f'control = {{ "Gain 1" = {channel_gain:.4f} }} }}'
        )
        links.append(f'{{ output = "{previous}:Out" input = "{gain_name}:In 1" }}')
        outputs.append(f'"{gain_name}:Out"')

    arguments = (
        f'{{ node.description = "Oma Aux route {route["id"]}" '
        f'filter.graph = {{ nodes = [ {" ".join(nodes)} ] links = [ {" ".join(links)} ] '
        f'inputs = [ {" ".join(inputs)} ] outputs = [ {" ".join(outputs)} ] }} '
        f'audio.channels = 2 audio.position = [ FL FR ] '
        f'capture.props = {{ node.name = "{capture_name}" media.class = "Audio/Sink" '
        f'node.autoconnect = false stream.dont-remix = true }} '
        f'playback.props = {{ node.name = "{playback_name}" node.passive = true '
        f'node.autoconnect = false stream.dont-remix = true }} }}'
    )
    return arguments, capture_name, playback_name


def filter_control_params(settings: dict) -> list[tuple[str, float]]:
    pan = settings["pan"]
    channel_gains = (1.0 - max(0.0, pan), 1.0 + min(0.0, pan))
    parameters = []
    for channel, channel_gain in zip(("l", "r"), channel_gains, strict=True):
        parameters.extend(
            (f"{channel}_eq_{index}:Gain", gain)
            for index, gain in enumerate(settings["eq"])
        )
        parameters.append((f"{channel}_gain:Gain 1", channel_gain))
    return parameters


def set_filter_controls(route: dict, settings: dict) -> None:
    graph = normalize_graph(pipewire_dump(), include_managed=True)
    capture = endpoint_by_name(graph, "destinations", route["captureName"])
    if not capture:
        fail("PipeWire route filter disappeared")
    values = " ".join(
        f"{json.dumps(name)} {value:.4f}"
        for name, value in filter_control_params(settings)
    )
    try:
        result = subprocess.run(
            [
                "pw-cli",
                "set-param",
                str(capture["id"]),
                "Props",
                f"{{ params = [ {values} ] }}",
            ],
            capture_output=True,
            text=True,
            timeout=5,
        )
    except FileNotFoundError:
        fail("pw-cli is required")
    except subprocess.SubprocessError as error:
        fail(f"Could not update route filter: {error}")
    if result.returncode != 0:
        fail(result.stderr.strip() or "Could not update route filter")


def spawn_route_process(route: dict) -> None:
    generation = str(time.time_ns())
    arguments, capture_name, playback_name = filter_module_arguments(route, generation)
    command = f"load-module libpipewire-module-filter-chain {arguments}"
    marker = f"oma_aux_route_{route['id']}"
    process = subprocess.Popen(
        [
            "sh",
            "-c",
            '(printf "%s\\n" "$1"; exec sleep infinity) | exec pw-cli',
            marker,
            command,
        ],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    route.update(
        {
            "pid": process.pid,
            "processStart": process_start_time(process.pid),
            "captureName": capture_name,
            "playbackName": playback_name,
        }
    )


def wait_for_processor(route: dict) -> tuple[dict, dict, dict]:
    for _ in range(40):
        graph = normalize_graph(pipewire_dump(), include_managed=True)
        capture = endpoint_by_name(graph, "destinations", route["captureName"])
        playback = endpoint_by_name(graph, "sources", route["playbackName"])
        if capture and playback:
            return graph, capture, playback
        if not route_process_alive(route):
            break
        time.sleep(0.05)
    stop_route_process(route)
    fail("PipeWire could not start the route filter")


def connect_endpoint_pair(graph: dict, source: dict, destination: dict) -> None:
    existing = {
        (link["outputPort"], link["inputPort"])
        for link in graph["links"]
    }
    for output_port, input_port in endpoint_pairs(source, destination):
        if (output_port, input_port) not in existing:
            run_pw_link("-L", str(output_port), str(input_port))


def disconnect_endpoint_pair(graph: dict, source: dict, destination: dict) -> None:
    source_ids = {member["id"] for member in source.get("members", [source])}
    for link in graph["links"]:
        if link["outputNode"] in source_ids and link["inputNode"] == destination["id"]:
            run_pw_link("-d", str(link["id"]))


def activate_route(route: dict) -> None:
    public_graph = normalize_graph(pipewire_dump())
    source = saved_endpoint(public_graph, "sources", route, "source")
    destination = saved_endpoint(public_graph, "destinations", route, "destination")
    if not source or not destination:
        if route.get("status") != "unresolved":
            route["status"] = "waiting"
        return
    if not route_process_alive(route):
        spawn_route_process(route)
    graph, capture, playback = wait_for_processor(route)
    source = saved_endpoint(graph, "sources", route, "source")
    destination = saved_endpoint(graph, "destinations", route, "destination")
    if not source or not destination:
        route["status"] = "waiting"
        return
    connect_endpoint_pair(graph, source, capture)
    graph = normalize_graph(pipewire_dump(), include_managed=True)
    connect_endpoint_pair(graph, playback, destination)
    graph = normalize_graph(pipewire_dump(), include_managed=True)
    source = saved_endpoint(graph, "sources", route, "source")
    destination = saved_endpoint(graph, "destinations", route, "destination")
    capture = endpoint_by_name(graph, "destinations", route["captureName"])
    playback = endpoint_by_name(graph, "sources", route["playbackName"])
    if not all((source, destination, capture, playback)):
        route["status"] = "waiting"
        return
    # Do not remove direct links until every current member has a filtered path.
    intended = set(endpoint_pairs(source, capture) + endpoint_pairs(playback, destination))
    existing = {(link["outputPort"], link["inputPort"]) for link in graph["links"]}
    if not intended or not intended <= existing:
        route["status"] = "waiting"
        return
    disconnect_endpoint_pair(graph, source, destination)
    route["status"] = "connected"


def reconcile_routes() -> dict:
    with state_lock():
        state = load_state()
        changed = False
        if state.get("apps"):
            graph = normalize_graph(pipewire_dump())
            for key, record in state["apps"].items():
                old = json.dumps(record, sort_keys=True)
                source = next((s for s in graph["sources"] if s["key"] == key), None)
                if source:
                    if source.get("appControl"):
                        validate_app_settings(record["settings"])
                        apply_app_settings(source, record)
                else:
                    record["applied"] = {}
                changed = changed or old != json.dumps(record, sort_keys=True)
        for route in state["routes"]:
            old = dict(route)
            try:
                activate_route(route)
            except SystemExit:
                # Graph objects can vanish between dump and link operations.
                # Keep the saved intent and retry without killing the watcher.
                route["status"] = "waiting"
            changed = changed or route != old
        if changed:
            save_state(state)
        return state


def direct_routes(graph: dict) -> list[dict]:
    sources_by_node = {member["id"]: source for source in graph["sources"]
                       for member in source.get("members", [source])}
    grouped: dict[tuple[int, int], list[dict]] = defaultdict(list)
    for link in graph["links"]:
        source = sources_by_node.get(link["outputNode"])
        if source:
            grouped[(source["id"], link["inputNode"])].append(link)
    routes = []
    for (source_id, destination_id), links in grouped.items():
        source = next((item for item in graph["sources"] if item["id"] == source_id), None)
        destination = next(
            (item for item in graph["destinations"] if item["id"] == destination_id), None
        )
        if not source or not destination:
            continue
        intended = set(endpoint_pairs(source, destination))
        existing = {(link["outputPort"], link["inputPort"]) for link in links}
        routes.append(
            {
                "id": route_id(source["key"], destination["key"]),
                "sourceId": source_id,
                "sourceKey": source["key"],
                "destinationId": destination_id,
                "destinationKey": destination["key"],
                "status": "connected" if intended and intended <= existing else "partial",
                "filtered": False,
                "filter": default_filter(),
            }
        )
    return routes


def graph_snapshot() -> dict:
    state = reconcile_routes()
    graph = normalize_graph(pipewire_dump())
    routes_by_id = {route["id"]: route for route in direct_routes(graph)}
    for saved in state["routes"]:
        source = saved_endpoint(graph, "sources", saved, "source")
        destination = saved_endpoint(graph, "destinations", saved, "destination")
        if not source or not destination:
            continue
        routes_by_id[saved["id"]] = {
            "id": saved["id"],
            "sourceId": source["id"],
            "sourceKey": source["key"],
            "destinationId": destination["id"],
            "destinationKey": destination["key"],
            "status": saved.get("status", "waiting"),
            "filtered": saved.get("enabled", True),
            "filter": saved["filter"],
        }
    graph["routes"] = list(routes_by_id.values())
    graph["filterBands"] = [name for name, _, _ in FILTER_BANDS]
    return graph


def emit_snapshot() -> None:
    print(json.dumps(graph_snapshot(), separators=(",", ":")), flush=True)


def channel_pairs(outputs: list[dict], inputs: list[dict]) -> list[tuple[int, int]]:
    """Pair ports by channel, with useful mono and positional fallbacks."""
    by_output_channel: dict[str, list[dict]] = defaultdict(list)
    by_input_channel: dict[str, list[dict]] = defaultdict(list)
    for port in outputs:
        if port["channel"]:
            by_output_channel[port["channel"]].append(port)
    for port in inputs:
        if port["channel"]:
            by_input_channel[port["channel"]].append(port)

    pairs: list[tuple[int, int]] = []
    used_outputs: set[int] = set()
    used_inputs: set[int] = set()
    for channel in sorted(set(by_output_channel) & set(by_input_channel)):
        for output, input_ in zip(
            by_output_channel[channel], by_input_channel[channel], strict=False
        ):
            pairs.append((output["id"], input_["id"]))
            used_outputs.add(output["id"])
            used_inputs.add(input_["id"])

    remaining_outputs = [port for port in outputs if port["id"] not in used_outputs]
    remaining_inputs = [port for port in inputs if port["id"] not in used_inputs]
    if len(remaining_outputs) == 1:
        pairs.extend((remaining_outputs[0]["id"], port["id"]) for port in remaining_inputs)
    elif len(remaining_inputs) == 1:
        pairs.extend((port["id"], remaining_inputs[0]["id"]) for port in remaining_outputs)
    else:
        pairs.extend(
            (output["id"], input_["id"])
            for output, input_ in zip(
                remaining_outputs, remaining_inputs, strict=False
            )
        )
    return pairs


def endpoint_pairs(source: dict, destination: dict) -> list[tuple[int, int]]:
    return [pair for member in source.get("members", [source])
            for pair in channel_pairs(member["ports"], destination["ports"])]


def endpoint(graph: dict, collection: str, node_id: int | str) -> dict:
    for candidate in graph[collection]:
        if candidate.get("key") == node_id or any(
            str(member["id"]) == str(node_id) for member in candidate.get("members", [candidate])
        ):
            return candidate
    fail(f"PipeWire node {node_id} disappeared")


def run_pw_link(*arguments: str) -> None:
    try:
        result = subprocess.run(
            ["pw-link", *arguments], capture_output=True, text=True, timeout=5
        )
    except FileNotFoundError:
        fail("pw-link is required")
    except subprocess.SubprocessError as error:
        fail(f"pw-link failed: {error}")
    if result.returncode != 0:
        fail(result.stderr.strip() or "pw-link failed")


def connect_nodes(output_node: int | str, input_node: int | str) -> None:
    graph = normalize_graph(pipewire_dump())
    source = endpoint(graph, "sources", output_node)
    destination = endpoint(graph, "destinations", input_node)
    with state_lock():
        state = load_state()
        saved = saved_route_for_endpoints(state, graph, source, destination)
        if saved:
            activate_route(saved)
            save_state(state)
            return
    connect_endpoint_pair(graph, source, destination)


def disconnect_nodes(output_node: int | str, input_node: int | str) -> None:
    graph = normalize_graph(pipewire_dump())
    source = endpoint(graph, "sources", output_node)
    destination = endpoint(graph, "destinations", input_node)
    with state_lock():
        state = load_state()
        saved = saved_route_for_endpoints(state, graph, source, destination)
        if saved:
            stop_route_process(saved)
            state["routes"].remove(saved)
            save_state(state)
    disconnect_endpoint_pair(graph, source, destination)


def toggle_nodes(output_node: int | str, input_node: int | str) -> None:
    graph = normalize_graph(pipewire_dump())
    source = endpoint(graph, "sources", output_node)
    destination = endpoint(graph, "destinations", input_node)
    with state_lock():
        state = load_state()
        saved = saved_route_for_endpoints(state, graph, source, destination)
        if saved:
            stop_route_process(saved)
            state["routes"].remove(saved)
            save_state(state)
            disconnect_endpoint_pair(graph, source, destination)
            return
    intended = set(endpoint_pairs(source, destination))
    source_ids = {member["id"] for member in source.get("members", [source])}
    matching_links = [
        link
        for link in graph["links"]
        if link["outputNode"] in source_ids and link["inputNode"] == destination["id"]
    ]
    existing = {(link["outputPort"], link["inputPort"]) for link in matching_links}

    if intended and intended <= existing:
        for link in matching_links:
            run_pw_link("-d", str(link["id"]))
        return
    for output_port, input_port in sorted(intended - existing):
        run_pw_link("-L", str(output_port), str(input_port))


def set_route_filter(output_node: int | str, input_node: int | str, value: object) -> None:
    settings = validate_filter(value)
    graph = normalize_graph(pipewire_dump())
    source = endpoint(graph, "sources", output_node)
    destination = endpoint(graph, "destinations", input_node)
    identifier = route_id(source["key"], destination["key"])
    with state_lock():
        state = load_state()
        old_route = saved_route_for_endpoints(state, graph, source, destination)
        if old_route and route_process_alive(old_route):
            set_filter_controls(old_route, settings)
            old_route["filter"] = settings
            old_route["enabled"] = True
            save_state(state)
            return
        route = {
            "id": identifier,
            "sourceName": source["name"],
            "sourceKey": source["key"],
            "destinationName": destination["name"],
            "destinationKey": destination["key"],
            "filter": settings,
            "enabled": True,
            "status": "starting",
        }
        spawn_route_process(route)
        try:
            activate_route(route)
        except BaseException:
            stop_route_process(route)
            raise
        if old_route:
            stop_route_process(old_route)
            state["routes"].remove(old_route)
        state["routes"].append(route)
        save_state(state)


def clear_route_filter(output_node: int | str, input_node: int | str) -> None:
    graph = normalize_graph(pipewire_dump())
    source = endpoint(graph, "sources", output_node)
    destination = endpoint(graph, "destinations", input_node)
    with state_lock():
        state = load_state()
        route = saved_route_for_endpoints(state, graph, source, destination)
        if not route:
            return
        if not route_process_alive(route):
            activate_route(route)
        settings = default_filter()
        set_filter_controls(route, settings)
        route["filter"] = settings
        route["enabled"] = False
        save_state(state)


def watch_graph() -> None:
    try:
        monitor = subprocess.Popen(
            ["pw-link", "-iolm"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=False,
            bufsize=0,
        )
    except FileNotFoundError:
        fail("pw-link is required")

    stopping = False

    def stop(_signum=None, _frame=None):
        nonlocal stopping
        stopping = True
        if monitor.poll() is None:
            monitor.terminate()

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    selector = selectors.DefaultSelector()
    selector.register(monitor.stdout, selectors.EVENT_READ)
    refresh_due = 0.0
    retry_due = time.monotonic() + 2

    try:
        # Subscribe first so a graph change cannot fall between the initial
        # snapshot and monitor startup.
        emit_snapshot()
        while monitor.poll() is None:
            events = selector.select(timeout=0.25)
            if events:
                chunk = os.read(monitor.stdout.fileno(), 65536)
                if not chunk:
                    break
                if not refresh_due:
                    refresh_due = time.monotonic() + 0.12
            if (refresh_due and time.monotonic() >= refresh_due) or time.monotonic() >= retry_due:
                emit_snapshot()
                refresh_due = 0.0
                retry_due = time.monotonic() + 2
    finally:
        selector.close()
        if monitor.poll() is None:
            monitor.terminate()
        try:
            monitor.wait(timeout=1)
        except subprocess.TimeoutExpired:
            monitor.kill()
            monitor.wait(timeout=1)

    if not stopping:
        message = monitor.stderr.read().decode(errors="replace").strip()
        fail(message or "PipeWire graph monitor stopped unexpectedly")


def meter_targets(graph: dict) -> dict[str, tuple[str, ...]]:
    targets = {}
    for item in graph["sources"] + graph["destinations"]:
        if item["mediaClass"] not in ("Stream/Output/Audio", "Audio/Sink", "Audio/Source"):
            continue
        members = item.get("members", [item])
        serials = tuple(sorted({m["serial"] for m in members}))
        if serials and all(s.isdigit() and int(s) > 0 for s in serials):
            targets[item["key"]] = serials
    return targets


def meter_command(serial: str) -> list[str]:
    return ["pw-record", "--raw", "--format", "f32", "--rate", "48000",
            "--channels", "2", "--channel-map", "FL,FR", "--latency", "50ms",
            "--target", serial, "--properties", json.dumps({
                "node.name": f"{METER_PREFIX}{os.getpid()}_{serial}",
                "stream.monitor": True, "stream.capture.sink": True,
                "node.passive": True, "node.dont-fallback": True,
                "node.dont-reconnect": True, "node.dont-move": True,
                "object.linger": False,
            }), "-"]


def pcm_peaks(data: bytes) -> tuple[list[float], bytes]:
    end = len(data) - len(data) % 8
    samples = array.array("f")
    samples.frombytes(data[:end])
    return [min(1.0, max((abs(v) for v in samples[ch::2] if math.isfinite(v)),
                         default=0.0)) for ch in (0, 1)], data[end:]


def meter_levels(targets: dict, children: dict, now: float) -> dict:
    levels = {}
    for key, serials in targets.items():
        # Corked application streams may never deliver PCM. They must not
        # hide fresh peaks from other streams in the same application group.
        fresh = [children[s] for s in serials
                 if s in children and now - children[s]["last"] < 0.5]
        levels[key] = ([max(child["peak"][ch] for child in fresh)
                        for ch in (0, 1)] if fresh else None)
    return levels


def watch_meters() -> None:
    # This path deliberately never loads, reconciles, or writes saved routes.
    stopping = False
    parent = os.getppid()
    children = {}
    targets = {}
    retry = {}
    selector = selectors.DefaultSelector()

    def stop(_signum, _frame):
        nonlocal stopping
        stopping = True

    def child_setup():
        # Also reap captures if the helper is killed rather than terminated.
        ctypes.CDLL(None).prctl(1, signal.SIGTERM)
        if os.getppid() != helper_pid:
            os._exit(1)

    def retire(serial):
        child = children.pop(serial)
        process = child["process"]
        selector.unregister(process.stdout)
        if process.poll() is None:
            process.terminate()
        try:
            process.wait(timeout=0.3)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait()
        process.stdout.close()

    helper_pid = os.getpid()
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    refresh = emit = 0.0
    try:
        while not stopping and os.getppid() == parent:
            now = time.monotonic()
            if now >= refresh:
                try:
                    targets = meter_targets(normalize_graph(pipewire_dump()))
                except SystemExit:
                    targets = {}
                wanted = set()
                for serials in targets.values():
                    if len(wanted | set(serials)) <= METER_LIMIT:
                        wanted.update(serials)
                for serial in list(children):
                    if serial not in wanted:
                        retire(serial)
                retry = {s: due for s, due in retry.items() if s in wanted}
                for serial in sorted(wanted - children.keys()):
                    if stopping or now < retry.get(serial, 0):
                        continue
                    try:
                        process = subprocess.Popen(meter_command(serial), stdin=subprocess.DEVNULL,
                            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                            bufsize=0, preexec_fn=child_setup)
                    except OSError:
                        retry[serial] = now + 5
                        continue
                    children[serial] = {"process": process, "tail": b"", "peak": [0.0, 0.0],
                                        "last": 0.0}
                    selector.register(process.stdout, selectors.EVENT_READ, serial)
                refresh = time.monotonic() + 1
            for key, _mask in selector.select(timeout=0.05):
                serial = key.data
                child = children[serial]
                chunk = os.read(key.fd, 65536)
                if not chunk:
                    retire(serial)
                    retry[serial] = time.monotonic() + 5
                    continue
                peaks, child["tail"] = pcm_peaks(child["tail"] + chunk)
                child["peak"] = [max(a, b) for a, b in zip(child["peak"], peaks)]
                child["last"] = time.monotonic()
            now = time.monotonic()
            if now >= emit:
                levels = meter_levels(targets, children, now)
                print(json.dumps({"levels": levels}, separators=(",", ":")), flush=True)
                for child in children.values():
                    child["peak"] = [0.0, 0.0]
                emit = now + 0.1
    except BrokenPipeError:
        pass
    finally:
        for serial in list(children):
            retire(serial)
        selector.close()


def main(arguments: list[str]) -> None:
    command = arguments[0] if arguments else "snapshot"
    if command == "meters" and len(arguments) == 1:
        watch_meters()
        return
    if command == "snapshot" and len(arguments) == 1:
        emit_snapshot()
        return
    if command == "watch" and len(arguments) == 1:
        watch_graph()
        return
    if command == "app-set" and len(arguments) == 3:
        try:
            settings = json.loads(arguments[2])
        except json.JSONDecodeError:
            fail("App settings must be valid JSON")
        set_app_settings(arguments[1], settings)
        emit_snapshot()
        return
    if command in ("connect", "disconnect", "toggle") and len(arguments) == 3:
        output_node = arguments[1]
        input_node = arguments[2]
        if command == "connect":
            connect_nodes(output_node, input_node)
        elif command == "disconnect":
            disconnect_nodes(output_node, input_node)
        else:
            toggle_nodes(output_node, input_node)
        emit_snapshot()
        return
    if command == "filter-set" and len(arguments) == 4:
        try:
            settings = json.loads(arguments[3])
        except json.JSONDecodeError:
            fail("Filter settings must be valid JSON")
        set_route_filter(arguments[1], arguments[2], settings)
        emit_snapshot()
        return
    if command == "filter-clear" and len(arguments) == 3:
        clear_route_filter(arguments[1], arguments[2])
        emit_snapshot()
        return
    fail(
        "Usage: oma-aux [snapshot|watch|meters|toggle OUT_NODE IN_NODE|connect OUT_NODE "
        "IN_NODE|disconnect OUT_NODE IN_NODE|filter-set OUT_NODE IN_NODE JSON|"
        "filter-clear OUT_NODE IN_NODE|app-set APP_KEY JSON]"
    )


if __name__ == "__main__":
    main(sys.argv[1:])
